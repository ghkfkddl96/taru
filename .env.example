# 타루 환경변수 — 이 파일을 .env 로 복사한 뒤 값을 채워라.
# cp .env.example .env

# Discord 봇 토큰 (Developer Portal → Bot → Reset Token)
DISCORD_BOT_TOKEN=

# 타루가 멘션 없이도 듣는 채널 ID (Discord 채널 우클릭 → 채널 ID 복사)
DISCORD_HOME_CHANNEL=

# (선택) 메모리 저장 경로. 안 적으면 ~/Documents/Taru_Memory 사용.
# TARU_MEMORY_DIR=~/Documents/Taru_Memory

# (선택) 세션 노트 알림 주기(ms). 기본 30분.
# SESSION_NOTE_INTERVAL_MS=1800000
